# SiteVerdict MCP server — environment template. PLACEHOLDERS ONLY; never commit real values.
# stdio (local) use needs only APIFY_TOKEN. Everything else is for the remote HTTP endpoint.

# --- local / stdio ---------------------------------------------------------
APIFY_TOKEN=apify_api_xxx                  # the END USER's own token (stdio). Not used by the hosted endpoint.
SITEVERDICT_TOOLSETS=web                   # web, marketing, leads, compliance, travel, property, all
# SITEVERDICT_DRY_RUN=1                    # sample data, no Apify calls

# Optional: the user's OWN third-party keys for data tools (see siteverdict://tools)
# SITEVERDICT_SECRET_COMPANIES_HOUSE_API_KEY=
# SITEVERDICT_SECRET_HMRC_CLIENT_ID=
# SITEVERDICT_SECRET_HMRC_CLIENT_SECRET=
# SITEVERDICT_SECRET_GOOGLE_MAPS_API_KEY=
# SITEVERDICT_SECRET_SERPAPI_API_KEY=
# SITEVERDICT_SECRET_FLIGHT_DATA_API_KEY=
# SITEVERDICT_SECRET_EPC_API_TOKEN=

# --- remote / HTTP -----------------------------------------------------------
SITEVERDICT_HTTP_HOST=127.0.0.1
SITEVERDICT_HTTP_PORT=3333
SITEVERDICT_PUBLIC_URL=https://mcp.webrevenuescan.com
SITEVERDICT_ALLOWED_HOSTS=mcp.webrevenuescan.com
SITEVERDICT_ALLOWED_ORIGINS=                # browser-based MCP clients only (server-side clients send no Origin)
SITEVERDICT_TRUST_PROXY=1                   # only behind your own reverse proxy
SITEVERDICT_MAX_BODY_BYTES=262144
SITEVERDICT_IP_RATE_PER_MINUTE=120
SITEVERDICT_RATE_LIMIT_PER_MINUTE=20        # tool calls per user per minute
SITEVERDICT_MAX_CONCURRENT_RUNS=6

# OAuth 2.1 (built-in authorization server)
SITEVERDICT_OAUTH_ENABLED=1
SITEVERDICT_OAUTH_KEYS=REPLACE_WITH_32_BYTE_BASE64URL_KEY   # node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))" ; comma-list for rotation (new first)
SITEVERDICT_OAUTH_REDIRECT_HOSTS=claude.ai,claude.com,chatgpt.com   # optional allow-list; loopback (Claude Code) always allowed
SITEVERDICT_OAUTH_ACCESS_TTL_SECS=3600
SITEVERDICT_OAUTH_REFRESH_TTL_SECS=2592000
SITEVERDICT_ALLOW_API_KEYS=1                # also accept X-Apify-Token / X-API-Key (Claude "custom connection", Cursor)

# Optional SiteVerdict API backend (products/API-CONTRACT.md)
# SITEVERDICT_BACKEND=auto                  # apify | api | auto
# SITEVERDICT_API_BASE=https://api.webrevenuescan.com

# OpenAI domain verification token (served at /.well-known/openai-apps-challenge)
# SITEVERDICT_OPENAI_APPS_CHALLENGE=
