# EXAMPLE ONLY — for a future owner-approved deploy. Do not copy into /etc/nginx without review.
# TLS terminates here; the MCP server listens on 127.0.0.1:3333 (SITEVERDICT_TRUST_PROXY=1).
server {
    listen 443 ssl;
    http2 on;
    server_name mcp.webrevenuescan.com;
    # ssl_certificate /etc/letsencrypt/live/mcp.webrevenuescan.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/mcp.webrevenuescan.com/privkey.pem;

    client_max_body_size 256k;            # matches SITEVERDICT_MAX_BODY_BYTES
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://127.0.0.1:3333;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;   # overwrite, never append client values
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;                  # SSE responses
        proxy_read_timeout 300s;              # long tool calls (server answers within ~200 s)
    }
}
